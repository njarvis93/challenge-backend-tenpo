# Copiar a .env y ajustar si hace falta. Todos los valores tienen default en
# docker-compose.yml, asi que el proyecto levanta sin este archivo.

DB_NAME=tenpo
DB_USER=tenpo
DB_PASSWORD=tenpo
DB_PORT=5432

REDIS_PORT=6379
API_PORT=8080

# Probabilidad [0..1] de que el mock del servicio externo falle.
# 1.0 hace que se agoten los 3 intentos y la API responda 503.
MOCK_FAILURE_RATE=0.0

# Imagen que levanta docker-compose.yml. Cambialos solo si quieres usar otra
# imagen o tag distintos a los publicados en Docker Hub.
DOCKERHUB_IMAGE=njarvis93/tenpo-challenge
IMAGE_TAG=1.0.0
